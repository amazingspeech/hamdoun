MODEL_VERSION=
MODELS_DIR=models
API_KEYS_FILE=api_keys.json
AUDIT_LOG_FILE=audit.log
TENANTS_DB_PAD=tenants.db
CORS_ALLOWED_ORIGINS=
FORECASTING_ENCRYPT_AT_REST=false
FORECASTING_ENCRYPTIE_SLEUTEL=
# Rate limit per organisatie (Fase 4 Stap 7), niet per gebruiker of key:
# meerdere ingelogde teamleden of API-keys van dezelfde klant delen één
# budget. Zet dit ruim genoeg voor het gelijktijdige gebruik van de
# grootste klant — niet zo streng dat de tweede gelijktijdige gebruiker
# al geblokkeerd wordt door de eerste.
RATE_LIMIT_PER_MINUUT=90
# Sessiecookies krijgen de Secure-vlag tenzij expliciet uitgezet — laat dit
# op de standaardwaarde (aan) staan zodra HTTPS actief is (stap 6 van
# DEPLOY.md); alleen uitzetten voor lokale ontwikkeling zonder TLS.
SESSIE_COOKIE_SECURE=true

# Publieke basis-URL van deze deployment (geen slash op het eind) — nodig
# voor twee dingen: de link in een wachtwoord-reset-mail, en Stripe
# Checkout's success_url/cancel_url. Zet dit altijd, ook als self-serve
# signup (hieronder) nog uitstaat — zonder deze waarde werkt wachtwoord-
# reset ook niet (serving/app.py: POST /wachtwoord-reset/aanvragen stuurt
# dan stilzwijgend geen mail).
APP_BASIS_URL=https://forecasting-demo.tessar.nl

# Mailprovider (Zoho, zie FASE4-SAAS-FOUNDATION.md beslissing 7) — nodig
# voor wachtwoord-reset én de wekelijkse herbestel-mail (DEPLOY.md stap 8).
# Zonder deze vier ingevuld verstuurt security/mail.py simpelweg niets
# (MailNietGeconfigureerd, geen crash) — vul MAIL_SMTP_WACHTWOORD altijd
# rechtstreeks op de server in (nano .env), nooit via een commando dat het
# wachtwoord in de shell-history of een SSH-sessie-log zou zetten.
MAIL_SMTP_HOST=smtp.zoho.eu
MAIL_SMTP_POORT=587
MAIL_AFZENDER=info@tessar.nl
MAIL_SMTP_GEBRUIKER=info@tessar.nl
MAIL_SMTP_WACHTWOORD=

# Self-serve signup + Stripe-betaling (Fase 5 NODIG 5) — LEEG LATEN om
# self-serve aanmelden bewust uit te schakelen (POST /signup geeft dan een
# nette 503 i.p.v. een halve flow). Pas invullen zodra het Stripe-account
# geverifieerd is voor live-modus (bedrijfsgegevens/bankrekening, regel je
# zelf bij Stripe) én er een live Price-object bestaat. STRIPE_WEBHOOK_SECRET
# komt uit het webhook-endpoint dat je in het Stripe-dashboard aanmaakt,
# wijzend naar {APP_BASIS_URL}/webhooks/stripe — niet dezelfde waarde als
# een lokale `stripe listen`-sessie.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
