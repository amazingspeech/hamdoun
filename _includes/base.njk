<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="utf-8">

<!-- Google Consent Mode v2 (default: geweigerd totdat bezoeker akkoord geeft) -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied'
  });
</script>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-729MRG65E1"></script>
<script>
  gtag('js', new Date());
  gtag('config', 'G-729MRG65E1');
</script>
<script src="./assets/tessar-prefs.js" defer></script>

<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<meta name="description" content="{% block description %}{% endblock %}">
{% block canonical %}{% endblock %}
<meta name="theme-color" content="#F7F2E9">
{% block robots %}{% endblock %}
<link rel="icon" type="image/png" sizes="32x32" href="./assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="./assets/favicon-16.png">
<link rel="apple-touch-icon" href="./assets/apple-touch-icon.png">

{% block social %}{% endblock %}{% block jsonld %}{% endblock %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="./assets/tessar-design-tokens.css">
<style>
{% block styles %}{% endblock %}
</style>
</head>
<body>

{% include "header.njk" %}

{% block content %}{% endblock %}

{% include "footer-and-scripts.njk" -%}
<script src="./tessar-concierge-widget.js?v=4" defer></script>
</body>
</html>
